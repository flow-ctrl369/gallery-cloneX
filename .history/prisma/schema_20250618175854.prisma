datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id            Int      @id @default(autoincrement())
  exhibitionId  Int
  name          String
  email         String
  quantity      Int
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Offer {
  id            Int      @id @default(autoincrement())
  artworkId     Int
  artworkTitle  String
  name          String
  email         String
  phone         String
  offerAmount   Float
  message       String?
  status        String   @default("pending") // pending, accepted, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
} 